PORT=4000
DATABASE_URL=postgresql://usuario:senha@localhost:5432/classhub
# Gere um segredo forte, por exemplo com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-esta-chave-em-producao
CLIENT_URL=http://localhost:5173

# SMTP para e-mail de recuperação de senha (ex: Gmail com senha de app)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ClassHub <no-reply@classhub.local>"

# Web Push (notificações push reais) — gere com: npm run vapid:gen
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Tutor IA (Google Gemini) — gere em https://aistudio.google.com
AI_API_KEY=
AI_MODEL=gemini-3.5-flash
TUTOR_NAME=Lumi
