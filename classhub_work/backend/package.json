{
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:init": "node scripts/db-init.mjs",
    "vapid:gen": "node scripts/vapid-gen.mjs",
    "check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\" eslint.config.js tsconfig.json package.json"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "docx": "^9.8.1",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.15",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "pino": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  }
}
